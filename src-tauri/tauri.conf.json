{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoGET",
  "version": "0.1.0",
  "identifier": "com.videoget.tauri",
  "build": {
    "beforeBuildCommand": "npm run tauri:prepare",
    "frontendDist": "../web/public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/videoget-node"],
    "resources": ["resources/server/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
